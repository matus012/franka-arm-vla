Bootstrap: docker
From: ubuntu:24.04
# 113 image = 112's recipe (plain ubuntu:24.04, NOT nvidia/cuda: system cuBLAS shadows the wheel's, PERUN job 94932)
# + ffmpeg shared libs (torchcodec) + a second venv /opt/policy (LeRobot 0.6.1). Build context = hpc/ (sim/, policy/).

%files
    sim/pyproject.toml /opt/build/sim/pyproject.toml
    sim/uv.lock /opt/build/sim/uv.lock
    policy/pyproject.toml /opt/build/policy/pyproject.toml
    policy/uv.lock /opt/build/policy/uv.lock

%environment
    export PATH=/opt/venv/bin:$PATH
    export PYTHONUNBUFFERED=1

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates curl git ffmpeg libgl1 libglu1-mesa libx11-6 libxext6 libxrender1 libsm6 libxt6 libgomp1
    rm -rf /var/lib/apt/lists/*
    curl -LsSf https://astral.sh/uv/0.12.19/install.sh | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh
    export UV_PYTHON_INSTALL_DIR=/opt/python UV_LINK_MODE=copy
    uv python install 3.12
    cd /opt/build/sim
    UV_PROJECT_ENVIRONMENT=/opt/venv uv sync --frozen --no-install-project
    # usd-core and usd-exchange both ship pxr/*.so; reinstall usd-core last so its pxr wins deterministically (112, 30 Sep 2026).
    uv pip install --python /opt/venv/bin/python --reinstall --no-deps usd-core==25.11
    cd /opt/build/policy
    UV_PROJECT_ENVIRONMENT=/opt/policy uv sync --frozen --no-install-project
    rm -rf /root/.cache/uv
    chmod -R a+rX /opt/python /opt/venv /opt/policy

%test
    /opt/venv/bin/python -c "import torch, isaaclab, newton, warp, h5py; print('sim torch', torch.__version__, 'warp', warp.__version__, 'newton', newton.__version__)"
    /opt/policy/bin/python -c "import lerobot, torch, av, torchcodec, h5py; print('policy torch', torch.__version__, 'lerobot', lerobot.__version__, 'torchcodec', torchcodec.__version__)"

%labels
    project 113_vla_tabletop
    stack py3.12 torch2.10.0+cu130 isaaclab3.0.0b2.post1 newton1.2.1 lerobot0.6.1

%help
    apptainer exec --nv vla_tabletop.sif /opt/venv/bin/python ...   (sim)   |   /opt/policy/bin/python ...   (policy)
