Bootstrap: docker
From: ubuntu:24.04
# (not nvidia/cuda: its system cuBLAS 13.0 on LD_LIBRARY_PATH shadowed the cuBLAS 13.1 wheel torch 2.10.0+cu130 needs
#  -> CUBLAS_STATUS_INVALID_VALUE on H200, PERUN job 94932. The wheels carry all CUDA libs; --nv injects the driver.)

%files
    pyproject.toml /opt/build/pyproject.toml
    uv.lock /opt/build/uv.lock

%environment
    export PATH=/opt/venv/bin:$PATH
    export PYTHONUNBUFFERED=1
    export UV_PROJECT_ENVIRONMENT=/opt/venv

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates curl git libgl1 libglu1-mesa libx11-6 libxext6 libxrender1 libsm6 libxt6 libgomp1
    rm -rf /var/lib/apt/lists/*
    curl -LsSf https://astral.sh/uv/0.12.19/install.sh | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh
    export UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_INSTALL_DIR=/opt/python UV_LINK_MODE=copy
    cd /opt/build
    uv python install 3.12
    uv sync --frozen --no-install-project
    # usd-core and usd-exchange both ship pxr/*.so; a parallel install leaves a non-deterministic mix (PERUN build,
    # 30 Sep 2026: Tf_PyEnumWrapper import error). Reinstall usd-core last so its pxr wins deterministically.
    uv pip install --python /opt/venv/bin/python --reinstall --no-deps usd-core==25.11
    rm -rf /root/.cache/uv
    chmod -R a+rX /opt/python /opt/venv

%test
    python -c "import torch, isaaclab, newton, warp, h5py; print('torch', torch.__version__, 'warp', warp.__version__, 'newton', newton.__version__)"

%labels
    project 112_vision_lift
    stack py3.12 torch2.10.0+cu130 isaaclab3.0.0b2.post1 newton1.2.1

%help
    apptainer exec --nv --bind <repo>:/workspace vision_lift.sif python /workspace/hpc/render_check.py
